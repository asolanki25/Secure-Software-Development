#!/usr/sbin/nft -f
# Default-deny host firewall for a Linux web server (load: sudo nft -f /etc/nftables.conf)
flush ruleset

define ADMIN_NET = 10.10.50.0/24

table inet filter {
    set ssh_block { type ipv4_addr; flags dynamic, timeout; timeout 15m; }

    chain input {
        type filter hook input priority 0; policy drop;
        iif "lo" accept
        ct state established,related accept
        ct state invalid drop

        # ICMP needed for diagnostics and path MTU, rate limited
        ip protocol icmp limit rate 5/second accept
        ip6 nexthdr icmpv6 limit rate 5/second accept

        # SSH only from the admin subnet; brute forcers blocked for 15 minutes
        ip saddr @ssh_block drop
        tcp dport 22 ip saddr $ADMIN_NET ct state new limit rate over 4/minute \
            add @ssh_block { ip saddr } drop
        tcp dport 22 ip saddr $ADMIN_NET ct state new accept

        # the only public service: HTTPS (80 just redirects to 443)
        tcp dport { 80, 443 } ct state new accept

        limit rate 10/minute log prefix "nft-drop: "
    }

    chain forward { type filter hook forward priority 0; policy drop; }

    chain output {
        type filter hook output priority 0; policy drop;    # egress filtering
        oif "lo" accept
        ct state established,related accept
        udp dport { 53, 123 } accept                         # DNS, NTP
        tcp dport { 53, 443 } accept                         # DNS, updates
        tcp dport 5432 ip daddr 10.10.20.15 accept           # our database only
        meta l4proto { icmp, ipv6-icmp } accept
    }
}
